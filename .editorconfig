root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.csproj]
indent_size = 2

[*.xml]
indent_size = 2

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.slnx]
indent_size = 2
